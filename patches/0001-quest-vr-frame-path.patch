+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Copyright (c) 2026 the OpenRAC contributors */
+#include <string.h>
+
+#include "game_protos.h"
+#include "openrac/game_host.h"
+
+/* sceVu0ScaleVector at 0x1251E8 (PAL func_00125328, rac1/host/vector.c): out = v * s, all four
+ * components (lqc2, vmulx.xyzw by the scale, sqc2). The NTSC decomp's find_moby_hit declares it
+ * with the scale first ($f12) and the two vectors after ($a0, $a1), which is how the registers
+ * meet it. Without the retail program's assembly to translate, the build had a stub here that did
+ * nothing, and the hit tests against a moby's joints read vectors never written. */
+void game_FUN_001251e8(float s, gaddr out, gaddr v) {
+    float in[4];
+    memcpy(in, G(v), sizeof in);
+    const float r[4] = {in[0] * s, in[1] * s, in[2] * s, in[3] * s};
+    memcpy(G(out), r, sizeof r);
+}
