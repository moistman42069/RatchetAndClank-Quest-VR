+        }
+        if (side < 0) {
+            // Closed onto its arm's elbow, so the skin blended across it ends there, else the other.
+            const int near = under(j, arms.arms[1].shoulder) || !arms.arms[0].shown ? 1 : 0;
+            for (std::size_t r = 0; r < 3; ++r) {
+                for (std::size_t c = 0; c < f[r].size(); ++c) {
+                    f[r][c] = 0.0f;
+                }
+            }
+            for (std::size_t c = 0; c < 3; ++c) {
+                f[3][c] = elbow[static_cast<std::size_t>(near)][c];
+            }
+            continue;
+        }
+        const auto& a = axes[static_cast<std::size_t>(side)];
+        const auto& s = shift[static_cast<std::size_t>(side)];
+        const auto moved = f;
+        for (std::size_t r = 0; r < 4; ++r) {
+            for (std::size_t c = 0; c < 3; ++c) {
+                f[r][c] = a[0][c] * moved[r][0] + a[1][c] * moved[r][1] + a[2][c] * moved[r][2] + (r == 3 ? s[c] : 0.0f);
+            }
+        }
+    }
+    return palette;
 }
 
