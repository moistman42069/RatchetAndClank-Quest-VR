+    std::vector<rac1::JointMatrix> palette = evaluate_moby(ram, moby, true, curl);
+    const std::vector<rac1::JointMatrix> pose = evaluate_moby(ram, moby, false, curl);
+    const auto cls = at<std::uint32_t>(ram, moby + 0x24);
+    if (palette.empty() || pose.size() != palette.size() || !inside(ram, cls, 0x48)) {
+        return palette;
+    }
+    const auto common_trans = at<std::uint32_t>(ram, cls + 0x18);
+    if (!inside(ram, common_trans, 0x10 * palette.size())) {
+        return palette;
+    }
+    const int joints = static_cast<int>(palette.size());
+    const auto parent = [&](int j) {
+        const auto word = at<std::uint32_t>(ram, common_trans + static_cast<std::uint32_t>(0x10 * j + 0xC));
+        const std::uint32_t p = (word - 0x70000000u) / 0x40u;
+        return word >= 0x70000000u && static_cast<int>(p) < j ? static_cast<int>(p) : -1;
+    };
+    const auto under = [&](int j, int root) {
+        for (int k = j; k >= 0; k = parent(k)) {
+            if (k == root) {
+                return true;
+            }
+        }
+        return false;
+    };
+
+    // The moby: world = position + rows * (scale * model), its rows the images of its axes.
+    const float scale = at<float>(ram, moby + 0x2C) / 1024.0f;
+    if (!(scale > 0.0f)) {
+        return palette;
+    }
+    std::array<V, 3> rows{};
+    V position{};
+    for (std::uint32_t r = 0; r < 3; ++r) {
+        for (std::uint32_t c = 0; c < 3; ++c) {
+            rows[r][c] = at<float>(ram, moby + 0xC0 + 0x10 * r + 4 * c);
+        }
+        position[r] = at<float>(ram, moby + 0x10 + 4 * r);
+    }
+
+    // Each arm's move in the model: m(v) = axes * v + shift, taking its joint to its place.
+    std::array<std::array<V, 3>, 2> axes{};
+    std::array<V, 2> shift{};
+    std::array<V, 2> elbow{};
+    for (std::size_t side = 0; side < 2; ++side) {
+        const MobyArm& arm = arms.arms[side];
+        if (arm.root < 0 || arm.root >= joints || arm.joint < 0 || arm.joint >= joints) {
+            continue;
+        }
+        const auto& j = pose[static_cast<std::size_t>(arm.joint)];
+        if (arm.slide) {
+            V at{};  // the joint in the world, as posed
+            for (std::size_t c = 0; c < 3; ++c) {
+                at[c] = position[c] + scale * (rows[0][c] * j[3][0] + rows[1][c] * j[3][1] + rows[2][c] * j[3][2]);
+            }
+            const V to{arm.position[0] - at[0], arm.position[1] - at[1], arm.position[2] - at[2]};
+            const float along = dot(to, arm.rows[0]);
+            for (std::size_t a = 0; a < 3; ++a) {
+                axes[side][a] = {a == 0 ? 1.0f : 0.0f, a == 1 ? 1.0f : 0.0f, a == 2 ? 1.0f : 0.0f};
+                shift[side][a] = along * dot(arm.rows[0], rows[a]) / scale;
+            }
+            const auto& root = pose[static_cast<std::size_t>(arm.root)];
+            elbow[side] = {root[3][0] + shift[side][0], root[3][1] + shift[side][1], root[3][2] + shift[side][2]};
+            continue;
+        }
+        // The joint's axes as columns b; the inverse's rows are the cross products over the determinant.
+        const V b0{j[0][0], j[0][1], j[0][2]}, b1{j[1][0], j[1][1], j[1][2]}, b2{j[2][0], j[2][1], j[2][2]};
+        const auto cross = [](const V& a, const V& c) {
+            return V{a[1] * c[2] - a[2] * c[1], a[2] * c[0] - a[0] * c[2], a[0] * c[1] - a[1] * c[0]};
+        };
+        const V i0 = cross(b1, b2), i1 = cross(b2, b0), i2 = cross(b0, b1);
+        const float det = dot(b0, i0);
+        if (!(std::abs(det) > 1e-6f)) {
+            continue;
+        }
+        // The joint's place in the model, from the world: rows are orthonormal.
+        std::array<V, 3> want{};  // images of the joint's axes, in the model
+        for (std::size_t a = 0; a < 3; ++a) {
+            want[a] = {dot(arm.rows[a], rows[0]), dot(arm.rows[a], rows[1]), dot(arm.rows[a], rows[2])};
+        }
+        const V to{arm.position[0] - position[0], arm.position[1] - position[1], arm.position[2] - position[2]};
+        const V place{dot(to, rows[0]) / scale, dot(to, rows[1]) / scale, dot(to, rows[2]) / scale};
+        // axes = want * inverse(b): column k is the sum of want's columns by the inverse's row entries.
+        for (std::size_t k = 0; k < 3; ++k) {
+            const V row{i0[k] / det, i1[k] / det, i2[k] / det};
+            for (std::size_t c = 0; c < 3; ++c) {
+                axes[side][k][c] = want[0][c] * row[0] + want[1][c] * row[1] + want[2][c] * row[2];
+            }
+        }
+        const auto apply = [&](const V& v) {
+            V out{};
+            for (std::size_t c = 0; c < 3; ++c) {
+                out[c] = axes[side][0][c] * v[0] + axes[side][1][c] * v[1] + axes[side][2][c] * v[2];
+            }
+            return out;
+        };
+        const V p = apply({j[3][0], j[3][1], j[3][2]});
+        shift[side] = {place[0] - p[0], place[1] - p[1], place[2] - p[2]};
+        const auto& root = pose[static_cast<std::size_t>(arm.root)];
+        const V e = apply({root[3][0], root[3][1], root[3][2]});
+        elbow[side] = {e[0] + shift[side][0], e[1] + shift[side][1], e[2] + shift[side][2]};
+    }
+
+    for (int j = 0; j < joints; ++j) {
+        auto& f = palette[static_cast<std::size_t>(j)];
+        int side = -1;
+        for (int s = 0; s < 2; ++s) {
+            if (arms.arms[static_cast<std::size_t>(s)].shown && under(j, arms.arms[static_cast<std::size_t>(s)].root)) {
+                side = s;
+            }
+        }
+        if (side < 0 && arms.cut_only > 0 && !under(j, arms.cut_only)) {
