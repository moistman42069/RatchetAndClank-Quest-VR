+                to.rows[r][c] = from.rows[r][c];
+            }
+            to.position[r] = from.position[r];
+        }
+        to.curl.clear();
+        for (int i = 0; i < from.curl_count && i < OPENRAC_ARM_CURLS; ++i) {
+            assets::rac1::JointModifier curl;
+            curl.joint = static_cast<std::uint8_t>(from.curl[i].joint);
+            for (std::size_t k = 0; k < 4; ++k) {
+                curl.quat[k] = from.curl[i].quat[k];
+            }
+            to.curl.push_back(curl);
+        }
+    }
+    return OPENRAC_HOOK_OK;
+}
