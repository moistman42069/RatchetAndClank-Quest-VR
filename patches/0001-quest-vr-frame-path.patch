+// A quad the game turned to its camera (a glow) turned to the viewer's eye, about its centre, by the
+// turn from the one to the other (sprites_face). Any other quad stays as the world has it.
+static void face_eye(renderer::EffectQuad& q) {
+    constexpr float kFacing = 0.97f;  // the quad's normal to the camera, its cosine: turned to it
+    const auto minus = [](const float* a, const float* b) {
+        return std::array<float, 3>{a[0] - b[0], a[1] - b[1], a[2] - b[2]};
+    };
+    const auto dot = [](const std::array<float, 3>& a, const std::array<float, 3>& b) {
+        return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+    };
+    const auto cross = [](const std::array<float, 3>& a, const std::array<float, 3>& b) {
+        return std::array<float, 3>{a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]};
+    };
+    const auto unit = [&](std::array<float, 3> v) {
+        const float length = std::sqrt(dot(v, v));
+        if (length > 0.000001f) {
+            v = {v[0] / length, v[1] / length, v[2] / length};
+        }
+        return v;
+    };
+    float centre[3] = {0, 0, 0};
+    for (int k = 0; k < 4; ++k) {
+        for (int i = 0; i < 3; ++i) {
+            centre[i] += q.corner[k][i] * 0.25f;
+        }
+    }
+    const std::array<float, 3> normal = unit(cross(minus(q.corner[1], q.corner[0]), minus(q.corner[2], q.corner[0])));
+    const std::array<float, 3> to_camera = unit(minus(g->sprite_camera.data(), centre));
+    const std::array<float, 3> to_eye = unit(minus(g->sprite_eye.data(), centre));
+    const float along = dot(to_camera, to_eye);
+    if (std::abs(dot(normal, to_camera)) < kFacing || along < -0.5f) {
+        return;
+    }
+    const std::array<float, 3> axis = cross(to_camera, to_eye);
+    for (int k = 0; k < 4; ++k) {
+        const std::array<float, 3> p = minus(q.corner[k], centre);
+        const std::array<float, 3> a = cross(axis, p);
+        const std::array<float, 3> b = cross(axis, a);
+        for (int i = 0; i < 3; ++i) {
+            q.corner[k][i] = centre[i] + p[i] + a[i] + b[i] / (1.0f + along);
+        }
+    }
+}
