+    void (*quiet_new_game)(int on);
+
+    /* The Quest fork's: a second hand item of class `oclass` (a VR left hand's), its address, 0 for
+     * none now, as a weapon's class may be waiting for a decode buffer. The moby loop does not run
+     * it; the mod places it and calls its update. Gone when its buffer is decoded over or the level
+     * ends: ask each tick. second_item_drop deletes it. */
+    uint32_t (*second_item)(int oclass);
+    void (*second_item_drop)(void);
+
+    /* The Quest fork's: where `count` points of the model of the moby at `moby` (three floats each,
+     * in its class's own units, as its mesh's vertices are) are in the world as joint `joint` carries
+     * them in the pose the port draws (its palette: the inverse bind included), three floats each into
+     * `xyz`. A part of a model that moves with its joint (the Visibomb's screen). Returns
+     * OPENRAC_HOOK_OK, or OPENRAC_HOOK_UNKNOWN for no such moby or joint. */
+    int (*moby_points_at)(openrac_gaddr moby, int joint, const float* points, int count, float* xyz);
 } openrac_api;
 
