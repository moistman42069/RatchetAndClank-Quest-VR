+        }
     }
     func_00205270__game(class_id, buffer_index);
     const int32_t now = GREF(int32_t, DECODE_BUFFER);
@@ -408,6 +417,67 @@ static int glove(int32_t item) {
     return item == 0x0A || item == 0x11 || item == 0x14 || item == 0x19;
 }
 
+/* The Quest fork's: a second hand item, the VR left hand's (openrac_api.second_item). Made as the
+ * game makes the hand's, in the buffer the hand's is not in (have_class); never run by the moby
+ * loop, drawn where the mod puts it, its update the mod's to call. Gone when its buffer is decoded
+ * over (the wrapper above) or the level goes: the mod asks again. */
+gaddr rac1_second_item(int32_t oclass) {
+    if (second_moby != 0 && second_load == rac1_program_loads() && second_class == oclass
+        && alive(second_moby, oclass)) {
+        return second_moby;
+    }
+    rac1_second_item_drop();
+    if (!in_level() || !have_class(oclass)) {
+        return 0;
+    }
+    const int entered = enter_level_context();
+    const gaddr m = func_0020D348(oclass);
+    if (m != 0 && GREF(gaddr, m + MOBY_CLASS) == 0) {
+        func_0020D678(m);
+        leave_level_context(entered);
+        return 0;
+    }
+    leave_level_context(entered);
+    if (m == 0) {
+        return 0;
+    }
+    GREF(uint32_t, m + MOBY_COLLISION) = 0;
+    GREF(int32_t, m + MOBY_COLLISION_OFF) = -1;
+    GREF(uint16_t, m + MOBY_FLAGS) = (uint16_t)((GREF(uint16_t, m + MOBY_FLAGS) | FLAG_NOT_RUN | FLAG_KEEP_MATRIX)
+                                                & ~FLAG_TARGET);
+    GREF(uint8_t, m + MOBY_UPDATE_DIST) = 0xFF;
+    GREF(uint8_t, m + MOBY_VISIBLE) = 1;
+    GREF(int16_t, m + MOBY_DRAW_DIST) = PIECE_DRAW_DIST;
+    if (GREF(uint8_t, GREF(gaddr, m + MOBY_CLASS) + 6u) != 0) {
+        GREF(uint8_t, m + MOBY_UNK73) = 0x18;
+    }
+    /* Lit and placed as the hero is, as a figure's piece is its figure. */
+    const gaddr hero_moby = GREF(gaddr, HERO_MOBY);
+    if (hero_moby != 0) {
+        memcpy(G(m + MOBY_COLOUR), G(hero_moby + MOBY_COLOUR), 8);
+        GREF(uint32_t, m + MOBY_LIGHT) = GREF(uint32_t, hero_moby + MOBY_LIGHT);
+        memcpy(G(m + MOBY_POS), G(hero_moby + MOBY_POS), 16);
+        memcpy(G(m + MOBY_ROT), G(hero_moby + MOBY_ROT), 16);
+    }
+    /* On its held sequence: the hero's item code blends a hand item there once its draw is done, and
+     * nothing runs that for this one. The mod advances it each tick. */
+    func_00213DE0(m, 1, 0, 1);
+    second_moby = m;
+    second_class = oclass;
+    second_load = rac1_program_loads();
+    return m;
+}
+
+void rac1_second_item_drop(void) {
+    const gaddr m = second_moby;
+    second_moby = 0;
+    if (m != 0 && second_load == rac1_program_loads() && in_level() && alive(m, second_class)) {
+        const int entered = enter_level_context();
+        func_0020D678(m);
+        leave_level_context(entered);
+    }
+}
+
