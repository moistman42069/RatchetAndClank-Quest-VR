+
+int api_moby_joints_at(openrac_gaddr m, const int* joints, int count, float* xyz) {
+    if (m == 0 || joints == nullptr || xyz == nullptr || count <= 0) {
+        return OPENRAC_HOOK_UNKNOWN;
+    }
+    const std::span<const std::uint8_t> ram(openrac_guest_base, 0x02000000u);
+    const auto pose = scene::moby_pose_matrices(ram, m);
+    float rows[3][4];
+    float position[4];
+    float scale = 0.0f;
+    std::memcpy(rows, openrac_guest_base + m + 0xC0, sizeof rows);
+    std::memcpy(position, openrac_guest_base + m + 0x10, sizeof position);
+    std::memcpy(&scale, openrac_guest_base + m + 0x2C, sizeof scale);
+    scale /= 1024.0f;
+    for (int i = 0; i < count; ++i) {
+        const int j = joints[i];
+        if (j < 0 || static_cast<std::size_t>(j) >= pose.size()) {
+            return OPENRAC_HOOK_UNKNOWN;
+        }
+        const auto& at = pose[static_cast<std::size_t>(j)][3];
+        for (int c = 0; c < 3; ++c) {
+            xyz[3 * i + c] = position[c] + scale * (rows[0][c] * at[0] + rows[1][c] * at[1] + rows[2][c] * at[2]);
+        }
+    }
+    return OPENRAC_HOOK_OK;
+}
+
+int api_moby_joints(int slot, const int* joints, int count, float* xyz) {
+    return api_moby_joints_at(moby_address(slot), joints, count, xyz);
+}
+
+int api_moby_points_at(openrac_gaddr m, int joint, const float* points, int count, float* xyz) {
+    if (m == 0 || points == nullptr || xyz == nullptr || count <= 0 || joint < 0) {
+        return OPENRAC_HOOK_UNKNOWN;
+    }
+    const std::span<const std::uint8_t> ram(openrac_guest_base, 0x02000000u);
+    const auto palette = scene::moby_palette(ram, m);
+    if (static_cast<std::size_t>(joint) >= palette.size()) {
+        return OPENRAC_HOOK_UNKNOWN;
+    }
+    float rows[3][4];
+    float position[4];
+    float scale = 0.0f;
+    std::memcpy(rows, openrac_guest_base + m + 0xC0, sizeof rows);
+    std::memcpy(position, openrac_guest_base + m + 0x10, sizeof position);
+    std::memcpy(&scale, openrac_guest_base + m + 0x2C, sizeof scale);
+    scale /= 1024.0f;
+    // The palette's rows are the images of the axes, then the translation, in the model.
+    const auto& f = palette[static_cast<std::size_t>(joint)];
+    for (int i = 0; i < count; ++i) {
+        const float* p = points + 3 * i;
+        float model[3];
+        for (int c = 0; c < 3; ++c) {
+            model[c] = f[0][c] * p[0] + f[1][c] * p[1] + f[2][c] * p[2] + f[3][c];
+        }
+        for (int c = 0; c < 3; ++c) {
+            xyz[3 * i + c] = position[c] + scale * (rows[0][c] * model[0] + rows[1][c] * model[1] + rows[2][c] * model[2]);
+        }
+    }
+    return OPENRAC_HOOK_OK;
+}
