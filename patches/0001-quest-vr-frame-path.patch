+std::vector<rac1::JointMatrix> moby_arms_palette(std::span<const std::uint8_t> ram, const MobyArms& arms) {
+    using V = std::array<float, 3>;
+    const auto dot = [](const V& a, const V& b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; };
+    const std::uint32_t moby = arms.moby;
