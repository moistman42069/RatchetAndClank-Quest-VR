+}
+
+// Circle: the held gun fired as his state machine fires it while he runs (its case for each item:
+// held or pressed, a press kept a few frames, or pressed alone). Items it has no case for fire from
+// their own update, which run_items runs; the wrench is the board's swing (strike), the Swingshot
+// takes him off the board (swing_from_board).
+// The held item's animation clock, which his update keeps and the ride skips: item_anim_frames counts
+// while item_anim_active is set, and the gun's own update fires on it (a gun only started, its frames
+// at 0, never shot: the Quest build's racboardweapons.sim, its rounds unspent). His animation is not
+// played on the board, so its end, which clears the flag on foot, is here: once Circle is up and the
+// shortest firing has played (18 frames, the Trespasser's shot at 17), as a held gun's arm comes down.
+void item_animation_tick(const ItemButtons& b, const openrac::Memory& mem, const ItemFns& f) {
+    if (mem.read<uint8_t>(hero_field(kItemAnimating)) == 0) {
+        mem.write<int32_t>(hero_field(kItemAnimFrames), 0);
+        return;
+    }
+    const int32_t frames = mem.read<int32_t>(hero_field(kItemAnimFrames)) + 1;
+    if (!b.fire_held && frames >= f.scale(0x12)) {
+        mem.write<uint8_t>(hero_field(kItemAnimating), 0);
+        mem.write<uint8_t>(hero_field(kItemAnimRaised), 0);
+        mem.write<int32_t>(hero_field(kItemAnimFrames), 0);
+        return;
+    }
+    mem.write<int32_t>(hero_field(kItemAnimFrames), frames);
+}
+
+void fire_item(const ItemButtons& b) {
+    static int age = 1000;  // frames since Circle went down
+    age = b.fire_pressed ? 0 : std::min(age + 1, 1000);
+    const ItemFns& f = item_fns();
+    if (f.start_item == nullptr || f.ammo == nullptr || f.scale == nullptr) return;
+    const openrac::Memory mem = mod().memory();
+    item_animation_tick(b, mem, f);
+    if (!item_ready(mem) || mem.read<uint8_t>(hero_field(kItemAnimating)) != 0) return;
+    const int32_t id = mem.read<int32_t>(hero_field(kItemSlot + 0x28u));
+    const int32_t ready = mem.read<int32_t>(hero_field(kItemSlot + 0x20u));
+    bool go = false;
+    switch (id) {
+    case 15: // held to fire
+        go = (b.fire_held && ready > f.scale(5)) || b.fire_pressed;
+        break;
+    case 10: case 17: case 20: case 24: case 25: // a press kept a few frames, or held a while
+        go = age < std::min(f.scale(7), ready) || (b.fire_held && ready > f.scale(8) && ready < f.scale(0x11));
+        break;
+    case 21: // pressed
+        go = b.fire_pressed;
+        break;
+    default:
+        break;
+    }
+    if (go && f.ammo(-1) != 0) {
+        f.start_item();
+        age = 1000;
+        trace("the board fires item " + std::to_string(id));
+    }
+}
+
+// The board's wrench swing, on Square as on foot (the game's own swing is a state of his update):
+// his upper body twists back, across and home, and the wrench hits what is in its reach ahead of him
+// once, a little into the swing, as the game's wrench does (the hit every enemy, crate and box reads).
+struct Strike {
+    float time = -1.0f; // seconds into the swing; below 0, none
+    bool hit = false;
+};
+Strike g_strike;
+constexpr float kStrikeTime = 0.36f;
+constexpr float kStrikeHitAt = 0.12f;
+constexpr float kStrikeReach = 2.6f;  // the game's units from him, flat
+constexpr float kStrikeHeight = 2.0f; // above or below him
+constexpr float kStrikeCos = 0.26f;   // within 75 degrees of his heading
+
+float smooth01(float x) {
+    x = std::clamp(x, 0.0f, 1.0f);
+    return x * x * (3.0f - 2.0f * x);
+}
+
+// His upper body's twist through the swing (radians about up, as the board's own upper-body turn).
+float strike_twist() {
+    if (g_strike.time < 0.0f) return 0.0f;
+    const float p = g_strike.time / kStrikeTime;
+    if (p < 0.25f) return -0.6f * smooth01(p / 0.25f);
+    if (p < 0.6f) return -0.6f + 1.6f * smooth01((p - 0.25f) / 0.35f);
+    return 1.0f - smooth01((p - 0.6f) / 0.4f);
+}
+
+void strike_hits(const openrac_pose& pose) {
+    if (!mod().has_world()) return;
+    const float c = std::cos(pose.rotation[2]), s = std::sin(pose.rotation[2]);
+    int hits = 0;
+    // A moby the game's hits reach (its flags +0x34, bit 0x4000: a crate, a box, an enemy), by its
+    // address: the slots are 0x100 apart, from his body's.
+    const openrac::Memory mem = mod().memory();
+    const uint32_t body = mem.read<uint32_t>(hero_field(0x2080u));
+    const int body_slot = body != 0 ? mod().moby_slot_of(body) : -1;
+    const int self = mod().figure_slot(-1);
+    for (const openrac_moby& m : mod().moby_list()) {
+        if ((m.flags & (OPENRAC_MOBY_HIDDEN | OPENRAC_MOBY_DRIVEN | OPENRAC_MOBY_DEAD)) || m.state >= 0x80 || m.slot == self ||
+            m.slot == body_slot) {
+            continue;
+        }
+        const bool hittable = body_slot >= 0 &&
+            (mem.read<uint16_t>(body + static_cast<uint32_t>(m.slot - body_slot) * 0x100u + 0x34u) & 0x4000u) != 0;
+        if (!(m.flags & OPENRAC_MOBY_CREATURE) && !hittable) continue;
+        const float dx = m.position[0] - pose.position[0], dy = m.position[1] - pose.position[1];
+        const float dz = m.position[2] - pose.position[2];
+        const float flat = std::sqrt(dx * dx + dy * dy);
+        if (flat > kStrikeReach || std::fabs(dz) > kStrikeHeight) continue;
+        if (flat > 0.3f && (dx * c + dy * s) / flat < kStrikeCos) continue;
+        openrac_hit h{};
+        h.size = sizeof h;
+        h.victim = m.slot;
+        h.attacker = mod().figure_slot(-1);
+        h.mask = 0x10000u;
+        h.damage = 1.0f;
+        std::copy(pose.position, pose.position + 3, h.position);
+        h.velocity[0] = 8.0f * c;
+        h.velocity[1] = 8.0f * s;
+        if (mod().moby_hit(h)) ++hits;
+    }
+    trace("wrench swing on the board: " + std::to_string(hits) + " hit");
+}
