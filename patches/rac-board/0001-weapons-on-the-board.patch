+    if (!playing() || !mod().hero_pose(pose)) return 0;
+    if (swing_state(pose.state)) {
+        if (pose.state >= 0x24 && pose.state <= 0x26) g_swing_pulled = true;
+        return 0;
+    }
+    return air_state(pose.state) || ground_state(pose.state) ? 1 : -1;
+}
