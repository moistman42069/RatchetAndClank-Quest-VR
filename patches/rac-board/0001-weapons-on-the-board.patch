+        ItemFns f;
+        f.start_item = mod().function<ItemFns::Void>(pal ? "func_L00_0020EB60" : "FUN_L00_0020e4c8");
+        f.ammo = mod().function<ItemFns::IntInt>(pal ? "func_L00_00234718" : "FUN_L00_00233e98");
+        f.scale = mod().function<ItemFns::IntInt>(pal ? "func_001F98C0" : "FUN_001f96f8");
+        f.queue = mod().function<ItemFns::Queue>(pal ? "func_001FFB38" : "FUN_001ff308");
+        f.health = mod().function<ItemFns::Int>(pal ? "func_L00_00235790" : "FUN_L00_00234e00");
+        f.keep = mod().function<ItemFns::Keep>(pal ? "func_L00_002367A8" : "FUN_L00_00235e18");
+        f.swing_target = mod().function<ItemFns::Void>(pal ? "func_L00_00222668" : "FUN_L00_00221ee0");
+        f.grapple_target = mod().function<ItemFns::Void>(pal ? "func_L00_002228E0" : "FUN_L00_00222158");
