 // Ratchet's body: his place and heading, held in his standing pose, the riding pose over it.
+// ---- Weapons on the board (setting weapons) ----
+
+// The game's update of what his hand holds (HeroItemsUpdate: the item made, attached, swapped and
+// updated, which fires it and makes its hits), which his own update runs after his state's. The ride
+// takes that update, so run_items runs this part of it. One C function for every level, per disc.
+using ItemsFn = void (*)();
+ItemsFn items_update() {
+    static const ItemsFn fn = mod().function<ItemsFn>(ctx().pal ? "func_L00_00210FE0" : "FUN_L00_00210928");
+    return fn;
