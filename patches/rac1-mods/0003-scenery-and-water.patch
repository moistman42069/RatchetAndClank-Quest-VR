+void scenery_and_water_are_each_games() {
+    Player host(1), member(2);
+    const std::vector<mp::Member> both = {{1, "P1"}, {2, "P2"}};
+    host.session.handle(info(both));
+    member.session.handle(info(both));
+    host.coop.choose({}, "New game");
+    CHECK(start_ready(host));
+    route({&host, &member});
+    tick({&host, &member}, 16);
+
+    // An enemy (key 0), a texture scroll (809, scenery), Rilgar's water (831, the host's height).
+    const std::uint32_t runs = mp::kMobyUpdates | mp::kMobyPlaced;
+    for (Player* p : {&host, &member}) {
+        p->game.now = {mp::kPhasePlaying, 0, 2};
+        p->game.level = {moby(0, 0, 300, runs | mp::kMobyCreature, 10.0f), moby(1, 1, 809, runs, 20.0f),
+                         moby(2, 2, 831, runs, 30.0f)};
+    }
+    member.game.level[1].pose.position[0] = 25.0f;
+    for (int i = 0; i < 20; ++i) {
+        tick({&host, &member}, 50);
+    }
+    CHECK((member.game.drives == std::set<int>{0}));
+
+    // The host's water rises and its scroll moves on: the member's water follows, its patches told; its scroll stays.
+    host.game.level[2].pose.position[2] = 3.0f;
+    host.game.level[2].pose.seq = 5;
+    host.game.level[1].pose.position[0] = 99.0f;
+    host.game.level[1].pose.seq = 5;
+    for (int i = 0; i < 20; ++i) {
+        tick({&host, &member}, 50);
+    }
+    CHECK(std::fabs(member.game.level[2].pose.position[2] - 3.0f) < 0.01f);
+    CHECK(std::count(member.game.world_calls.begin(), member.game.world_calls.end(), "water 2 831") >= 1);
+    CHECK(std::fabs(member.game.level[1].pose.position[0] - 25.0f) < 0.01f);
+    CHECK(std::count(host.game.world_calls.begin(), host.game.world_calls.end(), "water 2 831") == 0);
+}
