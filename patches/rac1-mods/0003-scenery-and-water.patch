+constexpr ShowSpan kShowSpans[] = {{0x20, 1},    {0x23, 1}, {0x2C, 0x14}, {0x5C, 8},   {0x70, 1},
+                                   {0x7F, 0x11}, {0x98, 4}, {0xB8, 6},    {0xC0, 0x30}};
+constexpr std::size_t kShowBody = 106;
+constexpr std::uint8_t kShowParent = 0xFF;
+/* Game::show_make's word for a pointer at the copy itself. */
+constexpr int kShowSelf = -2;
+
+struct ShowMoby {
+    int oclass = 0;
+    Pose pose;
+    std::uint8_t body[kShowBody] = {};
+    std::uint8_t vars[kShowVars] = {};
+
+    struct Pointer {
+        std::uint8_t word = 0;
+        int slot = -1;
+        std::uint8_t offset = 0;
+        bool vars = false;
+    };
+
+    std::vector<Pointer> pointers;
+};
