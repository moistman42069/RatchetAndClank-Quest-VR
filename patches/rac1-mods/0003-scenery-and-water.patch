+// QUEST-VR (world.hpp's show copies, "Orders"): Hoven's reservoir (384) drained by the host's switch drains in a member
+// of this build too: its own update, given command 8 when the host's says it drained (1), and 4 when it filled (2). It is
+// given each once (its own update keeps the order), not while it is in another state, and a member without show copies
+// gets none.
+void a_members_reservoir_drains_as_the_hosts() {
+    for (const bool shows : {true, false}) {
+        Player host(1), member(2);
+        const std::vector<mp::Member> both = {{1, "P1"}, {2, "P2"}};
+        host.session.handle(info(both));
+        member.session.handle(info(both));
+        host.coop.choose({}, "New game");
+        CHECK(start_ready(host));
+        route({&host, &member});
+        tick({&host, &member}, 16);
+        const std::uint32_t runs = mp::kMobyUpdates | mp::kMobyPlaced;
+
+        for (Player* p : {&host, &member}) {
+            p->game.now = {mp::kPhasePlaying, 0, 2};
+            p->game.level = {moby(0, 0, 300, runs | mp::kMobyCreature, 10.0f), moby(1, 1, 384, runs, 20.0f)};
+            p->game.orders[1] = (1 << 8) | 0;  // in its state 1, no order yet
+        }
+
+        host.game.disc = 1;
+        member.game.disc = shows ? 1 : 0;
+
+        for (int i = 0; i < 20; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(member.world.synced());
+        const auto orders_given = [&member](const std::string& call) {
+            return std::count(member.game.world_calls.begin(), member.game.world_calls.end(), call);
+        };
+        CHECK(orders_given("order 1 8") == 0 && orders_given("order 1 4") == 0);
+
+        // The host's switch: its reservoir drains (its update keeps 1).
+        host.game.orders[1] = (1 << 8) | 1;
+
+        for (int i = 0; i < 10; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(orders_given("order 1 8") == (shows ? 1 : 0));
+
+        if (!shows) {
+            continue;
+        }
+
+        // Its own update acts and keeps 1; told again (every kShowOrderEveryMs), it is not given it again.
+        member.game.orders[1] = (1 << 8) | 1;
+
+        for (int i = 0; i < 60; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(orders_given("order 1 8") == 1);
+
+        // Filled again at the host, while the member's is in another state: nothing until it is back in its state 1.
+        host.game.orders[1] = (1 << 8) | 2;
+        member.game.orders[1] = (3 << 8) | 1;
+
+        for (int i = 0; i < 10; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(orders_given("order 1 4") == 0);
+        member.game.orders[1] = (1 << 8) | 1;
+
+        for (int i = 0; i < 60; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(orders_given("order 1 4") == 1);
+    }
+}
