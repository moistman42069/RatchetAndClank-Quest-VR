+// QUEST-VR (world.hpp's show copies): what the host's enemy's update makes (its rocket) is made again in a member of
+// this build, on its disc, its words at what that member knows (the enemy, its own hero); its update keeps that
+// member's hero as he is, what it makes is its too, their hits are none there, and it goes once the host's has gone a
+// while. What no member drives makes (a crate's) is not shown; a member or host without them gets none.
+void show_copies_of_what_the_hosts_enemies_make() {
+    struct Case {
+        int host_disc;
+        int member_disc;
+        bool shows;
+    };
+
+    for (const Case c : {Case{1, 1, true}, Case{1, 0, false}, Case{1, 2, false}, Case{0, 1, false}}) {
+        Player host(1), member(2);
+        const std::vector<mp::Member> both = {{1, "P1"}, {2, "P2"}};
+        host.session.handle(info(both));
+        member.session.handle(info(both));
+        host.coop.choose({}, "New game");
+        CHECK(start_ready(host));
+        route({&host, &member});
+        tick({&host, &member}, 16);
+        const std::uint32_t runs = mp::kMobyUpdates | mp::kMobyPlaced;
+
+        for (Player* p : {&host, &member}) {
+            p->game.now = {mp::kPhasePlaying, 0, 2};
+            p->game.level = {moby(0, 0, 300, runs | mp::kMobyCreature, 10.0f), moby(1, 1, 500, runs, 20.0f)};
+        }
+
+        host.game.disc = c.host_disc;
+        member.game.disc = c.member_disc;
+        host.game.spawn_states = {{800, 0xFE}, {801, 0xFF}};
+        member.game.spawn_states = {{800, 0xFF}};
+        host.game.hero_pose.position[0] = 100.0f;
+        member.game.hero_pose.position[0] = 12.0f;
+
+        for (int i = 0; i < 20; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(member.world.synced());
+
+        // The enemy's update makes a rocket, its words at the enemy and at the member's figure there; the crate's
+        // makes a chip.
+        const int figure = 100 + host.coop.figure_of(2);
+        host.world.gate(0, mp::kMobyBefore);
+        const int rocket = host.game.create(1234, 11.0f);
+        mp::ShowMoby rm;
+        rm.oclass = 1234;
+        rm.pose = pose_at(11.0f);
+        rm.body[0] = 3;
+        rm.vars[0] = 5;
+        rm.pointers = {{1, 0, 0x10, false}, {2, figure, 0, true}};
+        host.game.show_mobys[rocket] = rm;
+        host.world.gate(0, mp::kMobyAfter);
+        host.world.gate(1, mp::kMobyBefore);
+        const int chip = host.game.create(1235, 20.0f);
+        mp::ShowMoby cm;
+        cm.oclass = 1235;
+        cm.pose = pose_at(20.0f);
+        host.game.show_mobys[chip] = cm;
+        host.world.gate(1, mp::kMobyAfter);
+        CHECK(rocket == 800 && chip == 801);
+
+        for (int i = 0; i < 10; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(member.game.shows_made.size() == (c.shows ? 1u : 0u));
+
+        if (!c.shows) {
+            CHECK(std::count_if(member.game.level.begin(), member.game.level.end(), [](const mp::MobyState& m) {
+                      return m.oclass == 1234 || m.oclass == 1235;
+                  }) == 0);
+            continue;
+        }
+
+        const auto& [made, to] = member.game.shows_made[0];
+        CHECK(made.oclass == 1234 && made.body[0] == 3 && made.vars[0] == 5 && made.pointers.size() == 2);
+        CHECK(to.size() == 2 && to[0] == 0 && to[1] == 99 && made.pointers[1].vars && made.pointers[0].offset == 0x10);
+        CHECK(member.game.world_calls.end()
+              != std::find(member.game.world_calls.begin(), member.game.world_calls.end(), "show 1234 800"));
+
+        // Its update: the member's hero as he is; what it makes is its own; their hits are none here.
+        const int stood = member.game.stood;
+        CHECK(!member.world.gate(800, mp::kMobyBefore));
+        CHECK(member.game.stood == stood + 1 && member.game.world_calls.back() == "stand 12 -1");
+        const int spark = member.game.create(1236, 12.0f);
+        CHECK(!member.world.gate(800, mp::kMobyAfter));
+        tick({&host, &member}, 50);
+        CHECK(!member.world.gate(spark, mp::kMobyBefore) && member.game.stood == stood + 2);
+        member.world.gate(spark, mp::kMobyAfter);
+        // The enemy's own update is not this game's to run: no stand-in for it.
+        const std::size_t host_hits = host.game.hits.size();
+        mp::Hit blast;
+        blast.victim = 99;
+        blast.attacker = 800;
+        blast.damage = 3.0f;
+        CHECK(member.world.hit(blast));
+        blast.attacker = spark;
+        CHECK(member.world.hit(blast));
+        blast.victim = 0;
+        CHECK(member.world.hit(blast));
+        route({&host, &member});
+        CHECK(host.game.hits.size() == host_hits);
+
+        // The host's rocket goes: the member's, still flying, goes a while after.
+        host.game.destroy(rocket);
+        tick({&host, &member}, 50);
+        tick({&host, &member}, 50);
+        CHECK(std::find(member.game.world_calls.begin(), member.game.world_calls.end(), "kill 800")
+              == member.game.world_calls.end());
+
+        for (int i = 0; i < 40; ++i) {
+            tick({&host, &member}, 50);
+        }
+
+        CHECK(std::find(member.game.world_calls.begin(), member.game.world_calls.end(), "kill 800")
+              != member.game.world_calls.end());
+        CHECK(member.game.shows_made.size() == 1);
+    }
+}
