+// --- QUEST-VR: water ---
+/* Each disc's moby array (a word: the array's address, 0x100 a moby) and the level code that puts a level's water
+ * patches, and their collision, at its water moby's height, as its update does when it moves it (rac1-decomp's
+ * names, the US addresses from OpenRAC's versionmap): Rilgar's (level 5, class 831), Pokitaru's (level 11, 1158)
+ * and its copy in Hoven (level 12, 19). Each takes the water moby. */
+struct WaterDisc {
+    const char* version;
+    openrac::gaddr moby_array;
+    openrac::gaddr rilgar;
+    openrac::gaddr pokitaru;
+    openrac::gaddr hoven;
+};
+
+constexpr WaterDisc kWaterDiscs[] = {
+    {"pal", 0x00160018u, 0x0030EA88u, 0x0030FB58u, 0x002C08A0u},
+    {"ntsc", 0x0015FF18u, 0x0030D5C0u, 0x0030E690u, 0x002BF6D0u},
+};
+
+bool ModGame::water_follows(int slot, int oclass) {
+    const WaterDisc* disc = nullptr;
+
+    for (const WaterDisc& d : kWaterDiscs) {
+        if (mod_.version() == d.version) {
+            disc = &d;
+        }
+    }
+
+    const int level = mod_.play_status().level;
+    const openrac::gaddr sync = oclass == 831 && level == 5      ? (disc ? disc->rilgar : 0u)
+                                : oclass == 1158 && level == 11 ? (disc ? disc->pokitaru : 0u)
+                                : oclass == 19 && level == 12   ? (disc ? disc->hoven : 0u)
+                                                                 : 0u;
+    const auto fn = reinterpret_cast<void (*)(openrac::gaddr)>(sync != 0 ? mod_.api().function_at(sync) : nullptr);
+
+    if (fn == nullptr || slot < 0) {
+        return false;
+    }
+
+    const openrac::gaddr moby = mod_.memory().read<openrac::gaddr>(mod_.relocate(disc->moby_array))
+                                + static_cast<openrac::gaddr>(slot) * 0x100u;
+
+    // Only the moby this slot names now (a level load may have moved the array).
+    if (mod_.moby_slot_of(moby) != slot) {
+        return false;
+    }
+
+    fn(moby);
+    return true;
+}
+// --- end QUEST-VR ---
+
+// --- QUEST-VR: show copies ---
+/* Each disc's moby globals (rac1-decomp's names; the US addresses from OpenRAC's versionmap): the moby array
+ * (resident_object_pool, 0x100 a moby), the first spawned slot and the end of them (moby_instance_end,
+ * moby_instance_perm_end), the spawned slots' pvars (g_moby_vars, 0x80 each, as CreateMoby gives them) and the tick
+ * count (world_update_time, what a deleted slot waits for). */
+struct ShowDisc {
+    const char* version;
+    int disc;
+    openrac::gaddr array;
+    openrac::gaddr instance_end;
+    openrac::gaddr perm_end;
+    openrac::gaddr vars;
+    openrac::gaddr update_time;
+};
+
+constexpr ShowDisc kShowDiscs[] = {
+    {"pal", 1, 0x00160018u, 0x0016001Cu, 0x00160020u, 0x00160028u, 0x0015F6F0u},
+    {"ntsc", 2, 0x0015FF18u, 0x0015FF1Cu, 0x0015FF20u, 0x0015FF28u, 0x0015F60Cu},
+};
+
+namespace {
+
+/* The moby's fields this reads (rac1-decomp's moby.h), and the game's memory (none of it past 32 MB). */
+constexpr openrac::gaddr kMobyBytes = 0x100;
+constexpr openrac::gaddr kMobyPos = 0x10;
+constexpr openrac::gaddr kMobyState = 0x20;
+constexpr openrac::gaddr kMobyScale = 0x2C;
+constexpr openrac::gaddr kMobySpawnFrame = 0x38;
+constexpr openrac::gaddr kMobyRot = 0x40;
+constexpr openrac::gaddr kMobyFrame = 0x50;
+constexpr openrac::gaddr kMobySeq = 0x52;
+constexpr openrac::gaddr kMobyAnimTime = 0x54;
+constexpr openrac::gaddr kMobyAnimSpeed = 0x58;
+constexpr openrac::gaddr kMobyPvars = 0x78;
+constexpr openrac::gaddr kMobyClass = 0xA6;
+constexpr openrac::gaddr kMobyParent = 0xB8;
+constexpr openrac::gaddr kShowMemory = 0x02000000u;
+
+const ShowDisc* show_disc_of(std::string_view version) {
+    for (const ShowDisc& d : kShowDiscs) {
+        if (version == d.version) {
+            return &d;
+        }
+    }
+
+    return nullptr;
+}
+
+}  // namespace
+
+bool ModGame::show_region(ShowRegion& out) const {
+    const ShowDisc* d = show_disc_of(mod_.version());
+
+    if (d == nullptr || !mod_.has_world()) {
+        return false;
+    }
+
+    const openrac::Memory memory = mod_.memory();
+    const auto array = memory.read<openrac::gaddr>(mod_.relocate(d->array));
+    const auto first = memory.read<openrac::gaddr>(mod_.relocate(d->instance_end));
+    const auto end = memory.read<openrac::gaddr>(mod_.relocate(d->perm_end));
+
+    if (array == 0 || first < array || end <= first || end > kShowMemory || (first - array) % kMobyBytes != 0) {
+        return false;
+    }
+
+    out.array = array;
+    out.first = static_cast<int>((first - array) / kMobyBytes);
+    out.end = static_cast<int>((end - array + kMobyBytes - 1) / kMobyBytes);
+    out.vars = memory.read<openrac::gaddr>(mod_.relocate(d->vars));
+    return out.vars < kShowMemory;
+}
+
+int ModGame::show_disc() {
+    const ShowDisc* d = show_disc_of(mod_.version());
+    ShowRegion region;
+    return d != nullptr && show_region(region) ? d->disc : 0;
+}
+
+std::uint32_t ModGame::show_layout() {
+    const ShowDisc* d = show_disc_of(mod_.version());
+    ShowRegion region;
+
+    if (d == nullptr || !show_region(region)) {
+        return 0;
+    }
+
+    // Where this build keeps the array's word, and where the level put the array and the spawned pvars.
+    std::uint32_t layout = mod_.relocate(d->array);
+    layout = layout * 31u + region.array;
+    layout = layout * 31u + region.vars;
+    return layout != 0 ? layout : 1u;
+}
+
+std::uint32_t ModGame::spawn_time() {
+    const ShowDisc* d = show_disc_of(mod_.version());
+    return d != nullptr ? mod_.memory().read<std::uint32_t>(mod_.relocate(d->update_time)) : 0u;
+}
+
+int ModGame::spawn_slot_free(int from) {
+    ShowRegion region;
+
+    if (!show_region(region)) {
+        return -1;
+    }
+
+    const openrac::Memory memory = mod_.memory();
+    const std::uint64_t now = spawn_time();
+
+    // CreateMoby's own test: dead, and its wait over.
+    for (int slot = std::max(from, region.first); slot < region.end; ++slot) {
+        const openrac::gaddr moby = region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes;
+
+        if (memory.read<std::uint8_t>(moby + kMobyState) >= 0xFE
+            && now >= memory.read<std::uint64_t>(moby + kMobySpawnFrame)) {
+            return slot;
+        }
+    }
+
+    return -1;
+}
+
+int ModGame::spawn_slot_state(int slot) {
+    ShowRegion region;
+
+    if (!show_region(region) || slot < region.first || slot >= region.end) {
+        return -1;
+    }
+
+    return mod_.memory().read<std::uint8_t>(region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes + kMobyState);
+}
+
+bool ModGame::show_read(int slot, mp::ShowMoby& out) {
+    ShowRegion region;
+
+    if (!show_region(region) || slot < 0 || slot >= region.end) {
+        return false;
+    }
+
+    const openrac::Memory memory = mod_.memory();
+    const openrac::gaddr moby = region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes;
+
+    if (memory.read<std::uint8_t>(moby + kMobyState) >= 0xFE) {
+        return false;
+    }
+
+    out = mp::ShowMoby{};
+    out.oclass = memory.read<std::int16_t>(moby + kMobyClass);
+
+    for (openrac::gaddr i = 0; i < 3; ++i) {
+        out.pose.position[i] = memory.read<float>(moby + kMobyPos + 4 * i);
+        out.pose.rotation[i] = memory.read<float>(moby + kMobyRot + 4 * i);
+    }
+
+    out.pose.scale = memory.read<float>(moby + kMobyScale);
+    out.pose.seq = memory.read<std::uint8_t>(moby + kMobySeq);
+    out.pose.frame = memory.read<std::uint8_t>(moby + kMobyFrame);
+    out.pose.next_frame = out.pose.frame + 1;
+    out.pose.anim_time = memory.read<float>(moby + kMobyAnimTime);
+    out.pose.anim_speed = memory.read<float>(moby + kMobyAnimSpeed);
+    std::size_t at = 0;
+
+    for (const mp::ShowSpan& span : mp::kShowSpans) {
+        read_bytes(memory, moby + span.at, out.body + at, span.size);
+        at += span.size;
+    }
+
+    const auto pvars = memory.read<openrac::gaddr>(moby + kMobyPvars);
+
+    if (pvars != 0 && pvars + mp::kShowVars <= kShowMemory) {
+        read_bytes(memory, pvars, out.vars, mp::kShowVars);
+    }
+
+    // The words at a moby (or the pvars of a spawned one): this game's slots, named in the other by the world.
+    const openrac::gaddr mobys_end = region.array + static_cast<openrac::gaddr>(region.end) * kMobyBytes;
+    const openrac::gaddr vars_end = region.vars + static_cast<openrac::gaddr>(region.end - region.first) * 0x80u;
+    const auto point = [&](std::uint32_t word, std::uint8_t where) {
+        if (word >= region.array && word < mobys_end) {
+            out.pointers.push_back({where, static_cast<int>((word - region.array) / kMobyBytes),
+                                    static_cast<std::uint8_t>((word - region.array) % kMobyBytes), false});
+        } else if (region.vars != 0 && word >= region.vars && word < vars_end) {
+            out.pointers.push_back({where, region.first + static_cast<int>((word - region.vars) / 0x80u),
+                                    static_cast<std::uint8_t>((word - region.vars) % 0x80u), true});
+        }
+    };
+
+    for (std::size_t w = 0; w < mp::kShowVars / 4; ++w) {
+        std::uint32_t word = 0;
+        std::memcpy(&word, out.vars + 4 * w, sizeof word);
+        point(word, static_cast<std::uint8_t>(w));
+    }
+
+    point(memory.read<std::uint32_t>(moby + kMobyParent), mp::kShowParent);
+    return out.oclass > 0;
+}
+
+int ModGame::show_make(const mp::ShowMoby& moby, const std::vector<int>& to) {
+    ShowRegion region;
+
+    if (!show_region(region) || to.size() != moby.pointers.size()) {
+        return -1;
+    }
+
+    // Made and posed as a driven one is, then let go: its own update runs it from here.
+    const int slot = mod_.moby_spawn(moby.oclass, moby_of(moby.pose));
+
+    if (slot < 0) {
+        return -1;
+    }
+
+    mod_.moby_drive(slot, false);
+    const openrac::Memory memory = mod_.memory();
+    const openrac::gaddr at = region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes;
+
+    if (slot >= region.end || mod_.moby_slot_of(at) != slot) {
+        mod_.moby_kill(slot);
+        return -1;
+    }
+
+    std::size_t from = 0;
+
+    for (const mp::ShowSpan& span : mp::kShowSpans) {
+        for (std::size_t b = 0; b < span.size; ++b) {
+            memory.write<std::uint8_t>(at + span.at + static_cast<openrac::gaddr>(b), moby.body[from + b]);
+        }
+
+        from += span.size;
+    }
+
+    const auto pvars = memory.read<openrac::gaddr>(at + kMobyPvars);
+    const bool has_vars = pvars != 0 && pvars + mp::kShowVars <= kShowMemory;
+
+    if (has_vars) {
+        for (std::size_t b = 0; b < mp::kShowVars; ++b) {
+            memory.write<std::uint8_t>(pvars + static_cast<openrac::gaddr>(b), moby.vars[b]);
+        }
+    }
+
+    for (std::size_t i = 0; i < moby.pointers.size(); ++i) {
+        const mp::ShowMoby::Pointer& p = moby.pointers[i];
+        const int target = to[i] == mp::kShowSelf ? slot : to[i];
+        std::uint32_t word = 0;
+
+        if (target >= 0 && target < region.end) {
+            const openrac::gaddr there = region.array + static_cast<openrac::gaddr>(target) * kMobyBytes;
+            const auto there_vars = memory.read<openrac::gaddr>(there + kMobyPvars);
+            word = !p.vars ? there + p.offset : there_vars != 0 ? there_vars + p.offset : 0u;
+        }
+
+        if (p.word == mp::kShowParent) {
+            memory.write<std::uint32_t>(at + kMobyParent, word);
+        } else if (has_vars && p.word < mp::kShowVars / 4) {
+            memory.write<std::uint32_t>(pvars + 4u * p.word, word);
+        }
+    }
+
+    return slot;
+}
+
+// Orders (world.hpp's order_class): Moby.command, the byte a level event writes for the moby's own update to act on.
+constexpr openrac::gaddr kMobyCommand = 0xBC;
+
+int ModGame::order_read(int slot) {
+    ShowRegion region;
+
+    if (!show_region(region) || slot < 0 || slot >= region.end) {
+        return -1;
+    }
+
+    const openrac::Memory memory = mod_.memory();
+    const openrac::gaddr moby = region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes;
+    const int state = memory.read<std::uint8_t>(moby + kMobyState);
+
+    return state >= 0x80 ? -1 : (state << 8) | memory.read<std::uint8_t>(moby + kMobyCommand);
+}
+
+void ModGame::order_give(int slot, int command) {
+    ShowRegion region;
+
+    if (!show_region(region) || slot < 0 || slot >= region.end || command < 0 || command > 0xFF) {
+        return;
+    }
+
+    const openrac::gaddr moby = region.array + static_cast<openrac::gaddr>(slot) * kMobyBytes;
+    mod_.memory().write<std::uint8_t>(moby + kMobyCommand, static_cast<std::uint8_t>(command));
+}
+// --- end QUEST-VR ---
+
 }  // namespace mpmod
