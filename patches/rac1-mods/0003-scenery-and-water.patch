+// QUEST-VR (world.hpp's show copies): their bytes: a copy, a WORLD's tail behind its entries (a plain member reads the
+// entries only, and the whole fits a datagram), a HELLO's after the digest (a plain host reads no further).
+void show_copy_bytes() {
+    mp::ShowRecord r;
+    r.id = 77;
+    r.maker = 0x8005;
+    r.age_ms = 40;
+    r.moby.oclass = 1234;
+    r.moby.pose = pose_at(11.0f);
+    r.moby.pose.rotation[2] = 1.25f;
+    r.moby.pose.seq = 3;
+    r.moby.pose.frame = 9;
+    r.moby.pose.anim_time = 0.25f;
+    r.moby.body[0] = 3;
+    r.moby.body[mp::kShowBody - 1] = 0x44;
+    r.moby.vars[0] = 5;
+    r.moby.vars[mp::kShowVars - 1] = 9;
+    r.refs = {{1, mp::ShowRefKind::kWorld, 0, 0x10, false},
+              {mp::kShowParent, mp::ShowRefKind::kPlayer, 2, 0, false},
+              {4, mp::ShowRefKind::kShow, 78, 0x20, true}};
+    mp::Writer w;
+    mp::encode_show(w, r);
+    CHECK(w.bytes().size() == mp::show_bytes(r));
+    mp::Reader rd(w.bytes().data(), w.bytes().size());
+    mp::ShowRecord back;
+    CHECK(mp::decode_show(rd, back) && rd.left() == 0);
+    CHECK(back.id == 77 && back.maker == 0x8005 && back.age_ms == 40 && back.moby.oclass == 1234);
+    CHECK(back.moby.pose.position[0] == 11.0f && back.moby.pose.rotation[2] == 1.25f && back.moby.pose.seq == 3);
+    CHECK(back.moby.pose.frame == 9 && back.moby.pose.anim_time == 0.25f);
+    CHECK(std::memcmp(back.moby.body, r.moby.body, mp::kShowBody) == 0);
+    CHECK(std::memcmp(back.moby.vars, r.moby.vars, mp::kShowVars) == 0);
+    CHECK(back.refs.size() == 3 && back.refs[1].word == mp::kShowParent && back.refs[1].kind == mp::ShowRefKind::kPlayer);
+    CHECK(back.refs[1].id == 2 && back.refs[2].vars && back.refs[2].offset == 0x20 && back.refs[2].id == 78);
+    Bytes bad = w.bytes();
+    bad[bad.size() - 7] = 9;  // the last word's kind
+    mp::Reader rbad(bad.data(), bad.size());
+    CHECK(!mp::decode_show(rbad, back));
+
+    // Behind a WORLD's entries, as many entries as leave their room.
+    const std::size_t keep = 5 + 2 + 3 * mp::show_bytes(r);
+    const std::size_t most =
+        std::min(mp::kWorldEntries, (mp::kShowDatagram - mp::kWorldHeadBytes - keep) / mp::kWorldEntryBytes);
+    const std::vector<mp::WorldEntry> entries(most, mp::WorldEntry{3, pose_at(1.0f)});
+    Bytes world = mp::encode_world(4, 99, entries, 5);
+    const Bytes tail = mp::encode_show_tail({r, r, r}, {12});
+    CHECK(tail.size() == keep && mp::encode_show_tail({}, {}).empty());
+    world.insert(world.end(), tail.begin(), tail.end());
+    CHECK(world.size() <= mp::kShowDatagram && mp::kShowDatagram + 3 + mp::kClientStateHeader <= mp::kMaxDatagramBytes);
+    int level = 0;
+    std::int64_t stamp = 0;
+    std::vector<mp::WorldEntry> got;
+    CHECK(mp::decode_world(world, level, stamp, got) && got.size() == most && level == 4);
+    std::vector<mp::ShowRecord> records;
+    std::vector<std::uint16_t> gone;
+    CHECK(mp::decode_show_tail(world, got.size(), records, gone) && records.size() == 3 && records[2].id == 77);
+    CHECK(gone.size() == 1 && gone[0] == 12);
+    CHECK(!mp::decode_show_tail(Bytes(world.begin(), world.end() - 1), got.size(), records, gone));
+    CHECK(records.empty() && !mp::decode_show_tail(mp::encode_world(4, 99, entries, 5), got.size(), records, gone));
+
+    // Orders behind the gone ids (a placed moby's key and the host's command); a tail without them gives none.
+    std::vector<mp::ShowOrder> orders = {{5, 9}};
+    Bytes plain_world = mp::encode_world(4, 99, {}, 5);
+    const Bytes plain_tail = mp::encode_show_tail({}, {12});
+    plain_world.insert(plain_world.end(), plain_tail.begin(), plain_tail.end());
+    CHECK(mp::decode_show_tail(plain_world, 0, records, gone, &orders) && orders.empty() && gone.size() == 1);
+    const Bytes ordered = mp::encode_show_tail({}, {}, {{2, 1}, {0x1234, 8}});
+    CHECK(ordered.size() == 5 + 1 + 3 * 2);
+    Bytes ordered_world = mp::encode_world(4, 99, {}, 5);
+    ordered_world.insert(ordered_world.end(), ordered.begin(), ordered.end());
+    CHECK(mp::decode_show_tail(ordered_world, 0, records, gone, &orders) && records.empty() && gone.empty());
+    CHECK(orders.size() == 2 && orders[0].id == 2 && orders[0].command == 1 && orders[1].id == 0x1234 && orders[1].command == 8);
+    CHECK(mp::decode_show_tail(ordered_world, 0, records, gone));  // read without them: the copies and gone alone
+    CHECK(!mp::decode_show_tail(Bytes(ordered_world.begin(), ordered_world.end() - 1), 0, records, gone, &orders));
+
+    // A HELLO's, after the digest.
+    mp::Writer h;
+    h.u8(1).i32(2).i32(3);
+    mp::encode_show_hello(h, 1, 0xABCDEF01u);
+    mp::Reader hr(h.bytes().data(), h.bytes().size());
+    hr.u8();
+    hr.i32();
+    hr.i32();
+    int disc = 0;
+    std::uint32_t layout = 0;
+    CHECK(mp::decode_show_hello(hr, disc, layout) && disc == 1 && layout == 0xABCDEF01u);
+    mp::Reader plain(h.bytes().data(), 9);
+    plain.u8();
+    plain.i32();
+    plain.i32();
+    CHECK(!mp::decode_show_hello(plain, disc, layout));
+}
