@@ -0,0 +1,955 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Copyright (c) 2026 the OpenRAC contributors
+ *
+ * QUEST-VR (Ratchet Quest VR's, patches/rac1-mods/0003): the show copies (world.hpp): what the host's enemies
+ * shoot, blow up into and throw off, made again in a member's game of this build, its hits and its doings to the
+ * hero kept off there.
+ */
+#include "world.hpp"
+#include "world_util.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstring>
+#include <utility>
+
+namespace mp {
+
+using namespace wire;
+
+namespace {
+
+constexpr std::uint8_t kShowQ = 'Q';
+constexpr std::uint8_t kShowV = 'V';
+/* The body and the pvars, word by word for the mask of those not zero: the body (kShowBody) rounded up to words. */
+constexpr std::size_t kShowBodyWords = (kShowBody + 3) / 4;
+constexpr std::size_t kShowWords = kShowBodyWords + kShowVars / 4;
+static_assert(kShowWords <= 64, "the mask is 64 bits");
+
+/* The image's word `i`: the body's bytes, then the pvars'. */
+void image_word(const ShowMoby& m, std::size_t i, std::uint8_t out[4]) {
+    for (std::size_t b = 0; b < 4; ++b) {
+        const std::size_t at = i * 4 + b;
+        out[b] = at < kShowBodyWords * 4 ? (at < kShowBody ? m.body[at] : 0) : m.vars[at - kShowBodyWords * 4];
+    }
+}
+
+void set_image_word(ShowMoby& m, std::size_t i, const std::uint8_t in[4]) {
+    for (std::size_t b = 0; b < 4; ++b) {
+        const std::size_t at = i * 4 + b;
+
+        if (at < kShowBody) {
+            m.body[at] = in[b];
+        } else if (at >= kShowBodyWords * 4) {
+            m.vars[at - kShowBodyWords * 4] = in[b];
+        }
+    }
+}
+
+std::uint64_t image_mask(const ShowMoby& m) {
+    std::uint64_t mask = 0;
+
+    for (std::size_t i = 0; i < kShowWords; ++i) {
+        std::uint8_t w[4];
+        image_word(m, i, w);
+
+        if ((w[0] | w[1] | w[2] | w[3]) != 0) {
+            mask |= std::uint64_t{1} << i;
+        }
+    }
+
+    return mask;
+}
+
+int bits(std::uint64_t mask) {
+    int n = 0;
+
+    for (; mask != 0; mask &= mask - 1) {
+        ++n;
+    }
+
+    return n;
+}
+
+}  // namespace
+
+void encode_show(Writer& w, const ShowRecord& record) {
+    const ShowMoby& m = record.moby;
+    u16(w, record.id);
+    u16(w, record.maker);
+    u16(w, record.age_ms);
+    u16(w, static_cast<std::uint16_t>(static_cast<std::int16_t>(m.oclass)));
+    vec(w, m.pose.position);
+    vec(w, m.pose.rotation);
+    f32(w, m.pose.scale);
+    w.u8(static_cast<std::uint8_t>(m.pose.seq)).u8(static_cast<std::uint8_t>(m.pose.frame));
+    f32(w, m.pose.anim_time);
+    f32(w, m.pose.anim_speed);
+    const std::uint64_t mask = image_mask(m);
+    w.i64(static_cast<std::int64_t>(mask));
+
+    for (std::size_t i = 0; i < kShowWords; ++i) {
+        if ((mask >> i & 1) != 0) {
+            std::uint8_t word[4];
+            image_word(m, i, word);
+            w.u8(word[0]).u8(word[1]).u8(word[2]).u8(word[3]);
+        }
+    }
+
+    const std::size_t refs = std::min(record.refs.size(), kShowRefsMost);
+    w.u8(static_cast<std::uint8_t>(refs));
+
+    for (std::size_t i = 0; i < refs; ++i) {
+        const ShowRef& ref = record.refs[i];
+        w.u8(ref.word).u8(static_cast<std::uint8_t>(ref.kind)).i32(ref.id).u8(ref.offset).u8(ref.vars ? 1 : 0);
+    }
+}
+
+std::size_t show_bytes(const ShowRecord& record) {
+    // id, maker, age, class; place, angles, scale; seq, frame, the animation's time and speed; the mask.
+    return 8 + 28 + 10 + 8 + 4 * static_cast<std::size_t>(bits(image_mask(record.moby))) + 1
+           + 8 * std::min(record.refs.size(), kShowRefsMost);
+}
+
+bool decode_show(Reader& r, ShowRecord& out) {
+    out = ShowRecord{};
+    ShowMoby& m = out.moby;
+    out.id = u16(r);
+    out.maker = u16(r);
+    out.age_ms = u16(r);
+    m.oclass = static_cast<std::int16_t>(u16(r));
+    vec(r, m.pose.position);
+    vec(r, m.pose.rotation);
+    m.pose.scale = f32(r);
+    m.pose.seq = r.u8();
+    m.pose.frame = r.u8();
+    m.pose.next_frame = m.pose.frame + 1;
+    m.pose.anim_time = f32(r);
+    m.pose.anim_speed = f32(r);
+    const auto mask = static_cast<std::uint64_t>(r.i64());
+
+    if (kShowWords < 64 && (mask >> kShowWords) != 0) {
+        return false;
+    }
+
+    for (std::size_t i = 0; i < kShowWords && r.ok(); ++i) {
+        if ((mask >> i & 1) != 0) {
+            std::uint8_t word[4];
+            word[0] = r.u8();
+            word[1] = r.u8();
+            word[2] = r.u8();
+            word[3] = r.u8();
+            set_image_word(m, i, word);
+        }
+    }
+
+    const std::uint8_t refs = r.u8();
+
+    if (refs > kShowRefsMost) {
+        return false;
+    }
+
+    for (std::uint8_t i = 0; i < refs && r.ok(); ++i) {
+        ShowRef ref;
+        ref.word = r.u8();
+        const std::uint8_t kind = r.u8();
+        ref.id = r.i32();
+        ref.offset = r.u8();
+        ref.vars = r.u8() != 0;
+
+        if ((ref.word >= kShowVars / 4 && ref.word != kShowParent) || kind == 0
+            || kind > static_cast<std::uint8_t>(ShowRefKind::kShow) || (ref.vars && ref.offset >= kShowVars)) {
+            return false;
+        }
+
+        ref.kind = static_cast<ShowRefKind>(kind);
+        out.refs.push_back(ref);
+    }
+
+    return r.ok() && m.oclass > 0;
+}
+
+Bytes encode_show_tail(const std::vector<ShowRecord>& records, const std::vector<std::uint16_t>& gone,
+                       const std::vector<ShowOrder>& orders) {
+    if (records.empty() && gone.empty() && orders.empty()) {
+        return {};
+    }
+
+    Writer w;
+    const std::size_t count = std::min<std::size_t>(records.size(), 255);
+    w.u8(kShowQ).u8(kShowV).u8(kShowVersion).u8(static_cast<std::uint8_t>(count));
+
+    for (std::size_t i = 0; i < count; ++i) {
+        encode_show(w, records[i]);
+    }
+
+    const std::size_t went = std::min<std::size_t>(gone.size(), 255);
+    w.u8(static_cast<std::uint8_t>(went));
+
+    for (std::size_t i = 0; i < went; ++i) {
+        u16(w, gone[i]);
+    }
+
+    // Orders, only when there are any: a tail without them ends at the gone ids, as before them.
+    if (!orders.empty()) {
+        const std::size_t told = std::min<std::size_t>(orders.size(), 255);
+        w.u8(static_cast<std::uint8_t>(told));
+
+        for (std::size_t i = 0; i < told; ++i) {
+            u16(w, orders[i].id);
+            w.u8(orders[i].command);
+        }
+    }
+
+    return w.bytes();
+}
+
+bool decode_show_tail(const Bytes& world, std::size_t entries, std::vector<ShowRecord>& records,
+                      std::vector<std::uint16_t>& gone, std::vector<ShowOrder>* orders) {
+    records.clear();
+    gone.clear();
+
+    if (orders != nullptr) {
+        orders->clear();
+    }
+    const std::size_t at = kWorldHeadBytes + entries * kWorldEntryBytes;
+
+    if (world.size() < at + 5) {
+        return false;
+    }
+
+    Reader r(world.data() + at, world.size() - at);
+
+    if (r.u8() != kShowQ || r.u8() != kShowV || r.u8() != kShowVersion) {
+        return false;
+    }
+
+    const std::uint8_t count = r.u8();
+
+    for (std::uint8_t i = 0; i < count && r.ok(); ++i) {
+        ShowRecord record;
+
+        if (!decode_show(r, record)) {
+            records.clear();
+            return false;
+        }
+
+        records.push_back(std::move(record));
+    }
+
+    const std::uint8_t went = r.u8();
+
+    for (std::uint8_t i = 0; i < went && r.ok(); ++i) {
+        gone.push_back(u16(r));
+    }
+
+    std::vector<ShowOrder> told;
+
+    if (r.ok() && r.left() > 0) {
+        const std::uint8_t count_told = r.u8();
+
+        for (std::uint8_t i = 0; i < count_told && r.ok(); ++i) {
+            ShowOrder order;
+            order.id = u16(r);
+            order.command = r.u8();
+            told.push_back(order);
+        }
+    }
+
+    if (!r.ok()) {
+        records.clear();
+        gone.clear();
+        return false;
+    }
+
+    if (orders != nullptr) {
+        *orders = std::move(told);
+    }
+
+    return true;
+}
+
+void encode_show_hello(Writer& w, int disc, std::uint32_t layout) {
+    w.u8(kShowQ).u8(kShowV).u8(kShowVersion).u8(static_cast<std::uint8_t>(disc));
+    w.i32(static_cast<std::int32_t>(layout));
+}
+
+bool decode_show_hello(Reader& r, int& disc, std::uint32_t& layout) {
+    if (r.left() < 8 || r.u8() != kShowQ || r.u8() != kShowV || r.u8() != kShowVersion) {
+        return false;
+    }
+
+    disc = r.u8();
+    layout = static_cast<std::uint32_t>(r.i32());
+    return r.ok() && disc != 0;
+}
+
+// --- The gate: who made what ---
+
+bool World::show_watching() const { return show_on_; }
+
+bool World::show_moby(int slot) const {
+    return slot >= 0 && (show_copies_.count(slot) != 0 || show_kin_.count(slot) != 0);
+}
+
+void World::show_refill(int from) {
+    while (show_free_.size() < kShowFreeLook) {
+        // Nothing past the last spawned slot: CreateMoby takes it, and the one after it is the last then.
+        if (!show_free_.empty() && show_free_.back().second) {
+            return;
+        }
+
+        const int slot = game_.spawn_slot_free(show_free_.empty() ? from : show_free_.back().first + 1);
+
+        if (slot < 0) {
+            return;
+        }
+
+        show_free_.emplace_back(slot, game_.spawn_slot_state(slot) == 0xFF);
+    }
+}
+
+void World::show_made(int slot, int maker) {
+    if (hosting_) {
+        ShowMade made;
+        made.maker = maker;
+
+        if (maker >= 0) {
+            const auto it = mobys_.find(maker);
+            const bool shared = shared_.count(maker) != 0 && it != mobys_.end() && !loot_class(it->second.oclass);
+            const bool placed = it != mobys_.end() && it->second.key >= 0 && (it->second.flags & kMobyUpdates) != 0
+                                && it->second.oclass != 0 && !local_class(it->second.oclass)
+                                && !water_follow_class(it->second.oclass);
+            made.shows = shared || placed;
+            made.maker_id = id_of(maker);
+        }
+
+        show_made_[slot] = made;
+    } else if (maker >= 0 && show_moby(maker)) {
+        // What a copy (or what it made) makes is the copy's too: kept off as it is.
+        show_kin_[slot] = 0;
+    }
+}
+
+void World::show_watch(int maker) {
+    const std::uint32_t time = game_.spawn_time();
+
+    // A new tick: the slots CreateMoby takes from here (one DeleteMoby freed waits two ticks, so in a tick the
+    // free ones only go).
+    if (!show_time_known_ || time != show_time_) {
+        show_time_known_ = true;
+        show_time_ = time;
+        show_free_.clear();
+        show_refill(0);
+        return;
+    }
+
+    // The first free one is the one CreateMoby takes first: free still, nothing was made.
+    if (show_free_.empty() || game_.spawn_slot_free(show_free_.front().first) == show_free_.front().first) {
+        return;
+    }
+
+    std::size_t used = 0;
+    int after = -1;
+
+    for (; used < show_free_.size(); ++used) {
+        const auto [slot, last] = show_free_[used];
+
+        if (game_.spawn_slot_free(slot) == slot) {
+            break;
+        }
+
+        const int state = game_.spawn_slot_state(slot);
+
+        // Taken (made and deleted at once: neither, gone already).
+        if (state >= 0 && state < 0xFE) {
+            show_made(slot, maker);
+        }
+
+        after = slot;
+
+        // The last one taken: CreateMoby made the next the last, and may have taken that one too, and so on.
+        if (last) {
+            for (int next = slot + 1;; ++next) {
+                const int s = game_.spawn_slot_state(next);
+
+                if (s < 0 || s >= 0xFE) {
+                    break;
+                }
+
+                show_made(next, maker);
+                after = next;
+            }
+
+            ++used;
+            break;
+        }
+    }
+
+    show_free_.erase(show_free_.begin(), show_free_.begin() + static_cast<std::ptrdiff_t>(used));
+    show_refill(after + 1);
+}
+
+bool World::show_gate(int slot) {
+    if (hosting_ || !show_moby(slot)) {
+        return false;
+    }
+
+    // The hero where he is, and as he is after: what the copy does to him the host's game does (DAMAGE).
+    if (show_hero_known_) {
+        game_.stand_in(show_hero_, -1);
+    }
+
+    return true;
+}
+
+// --- The host ---
+
+bool World::show_name(int slot, ShowRef& out) const {
+    if (slot < 0) {
+        return false;
+    }
+
+    if (slot == game_.figure_slot(-1)) {
+        out.kind = ShowRefKind::kPlayer;
+        out.id = session_.id();
+        return true;
+    }
+
+    for (const auto& [id, member] : members_) {
+        const int figure = coop_.figure_of(id);
+
+        if (figure >= 0 && game_.figure_slot(figure) == slot) {
+            out.kind = ShowRefKind::kPlayer;
+            out.id = id;
+            return true;
+        }
+    }
+
+    if (const auto shown = show_ids_.find(slot); shown != show_ids_.end()) {
+        out.kind = ShowRefKind::kShow;
+        out.id = shown->second.id;
+        return true;
+    }
+
+    const std::uint16_t id = id_of(slot);
+
+    if (id != kNoId) {
+        out.kind = ShowRefKind::kWorld;
+        out.id = id;
+        return true;
+    }
+
+    return false;
+}
+
+void World::show_hello(std::int32_t sender, Reader& r) {
+    int disc = 0;
+    std::uint32_t layout = 0;
+    ShowMember& sm = show_members_[sender];
+    const bool was = sm.shows;
+    sm = ShowMember{};
+    const bool said = decode_show_hello(r, disc, layout);
+    sm.shows = said && disc == game_.show_disc() && game_.show_disc() != 0 && layout == game_.show_layout();
+
+    if (said && !sm.shows) {
+        log("player " + std::to_string(sender) + " takes show copies, but of another disc or build: none");
+    } else if (sm.shows && !was) {
+        log("player " + std::to_string(sender) + " takes show copies");
+    }
+}
+
+void World::show_tick_host(std::uint64_t now) {
+    for (auto it = show_members_.begin(); it != show_members_.end();) {
+        it = members_.count(it->first) == 0 ? show_members_.erase(it) : std::next(it);
+    }
+
+    show_on_ = std::any_of(show_members_.begin(), show_members_.end(), [](const auto& m) { return m.second.shows; });
+
+    if (!show_on_) {
+        show_made_.clear();
+        show_ids_.clear();
+        show_orders_.clear();
+        return;
+    }
+
+    // Orders: the placed order_class mobys' commands now (Hoven's reservoir); each member that takes them is told all
+    // of them again every kShowOrderEveryMs, and any changed at once (show_orders_due).
+    show_orders_.clear();
+
+    for (const auto& [slot, m] : mobys_) {
+        if (m.key < 0 || !order_class(m.oclass) || show_orders_.size() >= kShowOrdersMost) {
+            continue;
+        }
+
+        const int read = game_.order_read(slot);
+        const std::uint16_t id = id_of(slot);
+
+        if (read >= 0 && id != kNoId) {
+            show_orders_[id] = static_cast<std::uint8_t>(read & 0xFF);
+        }
+    }
+
+    for (auto& [id, sm] : show_members_) {
+        if (sm.shows && now - sm.orders_ms >= kShowOrderEveryMs) {
+            sm.orders_due = true;
+        }
+    }
+
+    // Gone: the shown mobys no longer here (another made in the slot, or now shared), told to who has them.
+    for (auto it = show_ids_.begin(); it != show_ids_.end();) {
+        const auto moby = mobys_.find(it->first);
+
+        if (moby != mobys_.end() && moby->second.oclass == it->second.oclass && (moby->second.flags & kMobyDead) == 0
+            && show_made_.count(it->first) == 0 && shared_.count(it->first) == 0) {
+            ++it;
+            continue;
+        }
+
+        for (auto& [id, sm] : show_members_) {
+            if (sm.live.erase(it->second.id) != 0 && sm.gone.size() < kShowGoneMost) {
+                sm.gone[it->second.id] = kShowGoneTold;
+            }
+        }
+
+        it = show_ids_.erase(it);
+    }
+
+    // New: the spawned mobys an update of a moby the members drive made, past what the host shares anyway.
+    std::vector<std::pair<int, ShowMade>> fresh;
+
+    for (const auto& [slot, made] : show_made_) {
+        const auto moby = mobys_.find(slot);
+
+        if (!made.shows || moby == mobys_.end()) {
+            continue;
+        }
+
+        const MobyState& m = moby->second;
+
+        if (m.key >= 0 || m.oclass <= 0 || shared_.count(slot) != 0 || show_ids_.count(slot) != 0
+            || (m.flags & (kMobyScene | kMobyCreature | kMobyDead)) != 0 || bolt_class(m.oclass) || loot_class(m.oclass)
+            || spawned_bolt_class(m.oclass) || crate_class(m.oclass) || pickup_class(m.oclass)
+            || interactable_class(m.oclass)) {
+            continue;
+        }
+
+        fresh.emplace_back(slot, made);
+    }
+
+    show_made_.clear();
+
+    // Their ids first: one may point at another made with it.
+    for (const auto& [slot, made] : fresh) {
+        show_ids_[slot] = {mobys_[slot].oclass, show_next_};
+        show_next_ = static_cast<std::uint16_t>(show_next_ % 0x7FFF + 1);
+    }
+
+    for (const auto& [slot, made] : fresh) {
+        ShowRecord record;
+        record.id = show_ids_[slot].id;
+        record.maker = made.maker_id;
+        bool named = game_.show_read(slot, record.moby);
+
+        for (const ShowMoby::Pointer& p : record.moby.pointers) {
+            ShowRef ref;
+            ref.word = p.word;
+            ref.offset = p.offset;
+            ref.vars = p.vars;
+
+            // A word at a moby no member knows of: a copy without it might go wrong, so none.
+            if (!named || !show_name(p.slot, ref) || record.refs.size() >= kShowRefsMost) {
+                named = false;
+                break;
+            }
+
+            record.refs.push_back(ref);
+        }
+
+        record.moby.pointers.clear();
+
+        if (!named) {
+            trace_line("show", "not shown " + moby_name(slot) + ": a word at a moby the members do not know");
+            continue;
+        }
+
+        for (auto& [id, sm] : show_members_) {
+            const auto member = members_.find(id);
+            Pose at;
+
+            if (!sm.shows || member == members_.end() || !member->second.synced || !coop_.latest(id, at)
+                || at.level != level_ || distance2(at.position, record.moby.pose.position) > kShowReach * kShowReach) {
+                continue;
+            }
+
+            sm.out.push_back({now, record});
+            sm.live.insert(record.id);
+            ++show_made_count_;
+            trace_line("show", "copy " + std::to_string(record.id) + " of " + moby_name(slot) + " by "
+                                   + moby_name(made.maker) + " for " + std::to_string(id) + " words "
+                                   + std::to_string(record.refs.size()) + " bytes " + std::to_string(show_bytes(record)));
+        }
+    }
+}
