+void World::show_world_in(const Bytes& bytes, std::size_t entries, double time) {
+    std::vector<ShowRecord> records;
+    std::vector<std::uint16_t> gone;
+    std::vector<ShowOrder> orders;
+
+    if (!decode_show_tail(bytes, entries, records, gone, &orders)) {
+        return;
+    }
+
+    const std::uint64_t now = clock_();
+
+    // Orders: this game's own placed one given the order that brings it where the host's is (its own update acts).
+    for (const ShowOrder& order : orders) {
+        const int slot = slot_of(order.id);
+        const auto moby = slot >= 0 ? mobys_.find(slot) : mobys_.end();
+
+        if (moby == mobys_.end() || !order_class(moby->second.oclass)) {
+            continue;
+        }
+
+        const int read = game_.order_read(slot);
+
+        if (read < 0) {
+            continue;
+        }
+
+        const int give = order_for(moby->second.oclass, read >> 8, read & 0xFF, order.command);
+
+        if (give >= 0) {
+            game_.order_give(slot, give);
+            ++show_orders_given_;
+            log("order: " + moby_name(slot) + " given " + std::to_string(give) + " (its command " + std::to_string(read & 0xFF)
+                + ", the host's " + std::to_string(order.command) + ")");
+        }
+    }
+
+    for (const std::uint16_t id : gone) {
+        const auto at = show_slot_.find(id);
+        const auto copy = at != show_slot_.end() ? show_copies_.find(at->second) : show_copies_.end();
+
+        if (copy != show_copies_.end() && copy->second.gone_ms == 0) {
+            copy->second.gone_ms = now;
+        }
+    }
+
+    // Each at its maker's moment here: where this game shows its maker when it made it.
+    for (ShowRecord& record : records) {
+        double delay = kShowDelayMs;
+
+        if (const auto poses = record.maker != kNoId ? poses_.find(record.maker) : poses_.end(); poses != poses_.end()) {
+            delay = poses->second.delay_ms();
+        }
+
+        show_wait_.push_back({time - static_cast<double>(record.age_ms) + delay, std::move(record)});
+    }
+
+    while (show_wait_.size() > 2 * kShowMost) {
+        show_wait_.erase(show_wait_.begin());
+    }
+}
+
+void World::show_forget(int slot) {
+    if (const auto copy = show_copies_.find(slot); copy != show_copies_.end()) {
+        show_slot_.erase(copy->second.id);
+        show_copies_.erase(copy);
+    }
+
+    show_kin_.erase(slot);
+}
+
+void World::show_tick_member(std::uint64_t now) {
+    Pose hero;
+    show_hero_known_ = game_.hero(hero);
+
+    if (show_hero_known_) {
+        std::copy(hero.position, hero.position + 3, show_hero_);
+    }
+
+    // What left: gone here by itself (another moby in its slot now), or the host's gone a while, or too old.
+    for (auto it = show_copies_.begin(); it != show_copies_.end();) {
+        const auto moby = mobys_.find(it->first);
+        const ShowCopy& copy = it->second;
+
+        if (moby == mobys_.end() || moby->second.oclass != copy.oclass || (moby->second.flags & kMobyDead) != 0
+            || driven_.count(it->first) != 0) {
+            show_slot_.erase(copy.id);
+            it = show_copies_.erase(it);
+            continue;
+        }
+
+        if (now - copy.made_ms >= kShowLifeMs || (copy.gone_ms != 0 && now - copy.gone_ms >= kShowGoneMs)) {
+            kill(it->first, copy.gone_ms != 0 ? "show copy: the host's is gone" : "show copy: too old");
+            show_slot_.erase(copy.id);
+            it = show_copies_.erase(it);
+            continue;
+        }
+
+        ++it;
+    }
+
+    for (auto it = show_kin_.begin(); it != show_kin_.end();) {
+        const auto moby = mobys_.find(it->first);
+
+        if (moby == mobys_.end() || (it->second != 0 && moby->second.oclass != it->second)
+            || (moby->second.flags & kMobyDead) != 0 || driven_.count(it->first) != 0) {
+            it = show_kin_.erase(it);
+            continue;
+        }
+
+        it->second = moby->second.oclass;
+        ++it;
+    }
+
+    // The copies due: made, each once what its words name is here.
+    const auto t = static_cast<double>(now);
+    std::stable_sort(show_wait_.begin(), show_wait_.end(),
+                     [](const ShowWait& a, const ShowWait& b) { return a.due < b.due; });
+
+    for (bool more = true; more;) {
+        more = false;
+
+        for (auto it = show_wait_.begin(); it != show_wait_.end();) {
+            const ShowRecord& record = it->record;
+
+            if (it->due > t) {
+                break;
+            }
+
+            if (t - it->due > kShowOverdueMs || show_copies_.size() >= kShowMost || show_slot_.count(record.id) != 0) {
+                it = show_wait_.erase(it);
+                continue;
+            }
+
+            ShowMoby moby = record.moby;
+            std::vector<int> to;
+            bool waits = false;
+            bool lost = false;
+
+            for (const ShowRef& ref : record.refs) {
+                int slot = -1;
+
+                switch (ref.kind) {
+                    case ShowRefKind::kPlayer: {
+                        const int figure = ref.id == session_.id() ? -1 : coop_.figure_of(ref.id);
+                        slot = ref.id == session_.id() || figure >= 0 ? game_.figure_slot(figure) : -1;
+                        break;
+                    }
+                    case ShowRefKind::kWorld:
+                        slot = slot_of(static_cast<std::uint16_t>(ref.id));
+                        break;
+                    case ShowRefKind::kShow: {
+                        const auto made = show_slot_.find(static_cast<std::uint16_t>(ref.id));
+
+                        if (ref.id == record.id) {
+                            slot = kShowSelf;
+                        } else if (made != show_slot_.end()) {
+                            slot = made->second;
+                        } else if (std::any_of(show_wait_.begin(), show_wait_.end(),
+                                               [&](const ShowWait& w) { return w.record.id == ref.id; })) {
+                            waits = true;
+                        }
+
+                        break;
+                    }
+                    default:
+                        break;
+                }
+
+                if (slot == -1 && !waits) {
+                    lost = true;
+                }
+
+                moby.pointers.push_back({ref.word, slot, ref.offset, ref.vars});
+                to.push_back(slot);
+            }
+
+            if (lost) {
+                trace_line("show", "copy " + std::to_string(record.id) + " of class " + std::to_string(moby.oclass)
+                                       + " not made: a word at a moby not here");
+                it = show_wait_.erase(it);
+                continue;
+            }
+
+            if (waits) {
+                ++it;
+                continue;
+            }
+
+            const int slot = game_.show_make(moby, to);
+
+            if (slot >= 0) {
+                show_copies_[slot] = {record.id, moby.oclass, now, 0};
+                show_slot_[record.id] = slot;
+                ++show_made_count_;
+                more = true;
+            }
+
+            trace_line("show", "copy " + std::to_string(record.id) + " of class " + std::to_string(moby.oclass)
+                                   + (slot >= 0 ? " made in slot " + std::to_string(slot) : std::string(" refused by the game"))
+                                   + " at " + xyz(moby.pose.position) + ", " + std::to_string(static_cast<int>(t - it->due))
+                                   + " ms late");
+
+            it = show_wait_.erase(it);
+        }
+    }
+
+    show_on_ = !show_copies_.empty() || !show_kin_.empty();
+}
+
+void World::show_reset() {
+    show_made_.clear();
+    show_free_.clear();
+    show_time_known_ = false;
+    show_on_ = false;
+    show_members_.clear();
+    show_ids_.clear();
+    show_copies_.clear();
+    show_slot_.clear();
+    show_kin_.clear();
+    show_wait_.clear();
+    show_hero_known_ = false;
+    show_orders_.clear();
+}
