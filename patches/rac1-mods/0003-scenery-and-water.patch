+std::vector<ShowOrder> World::show_orders_due(const ShowMember& sm) const {
+    std::vector<ShowOrder> due;
+
+    for (const auto& [id, command] : show_orders_) {
+        const auto told = sm.orders_told.find(id);
+
+        if (sm.orders_due || told == sm.orders_told.end() || told->second != command) {
+            due.push_back({id, command});
+        }
+    }
+
+    return due;
+}
+
+std::size_t World::show_room(std::int32_t member) const {
+    const auto it = show_members_.find(member);
+
+    if (it == show_members_.end() || !it->second.shows) {
+        return 0;
+    }
+
+    const std::size_t orders = show_orders_due(it->second).size();
+
+    if (it->second.out.empty() && it->second.gone.empty() && orders == 0) {
+        return 0;
+    }
+
+    std::size_t bytes = 5 + 2 * it->second.gone.size() + (orders != 0 ? 1 + 3 * orders : 0);
+    bool any = false;
+
+    for (const ShowOut& o : it->second.out) {
+        const std::size_t n = show_bytes(o.record);
+
+        if (any && bytes + n > kShowRoom) {
+            break;
+        }
+
+        bytes += n;
+        any = true;
+    }
+
+    return std::min(bytes, kShowDatagram - kWorldHeadBytes);
+}
+
+Bytes World::show_tail(std::int32_t member, std::uint64_t now, std::size_t room, std::size_t& records) {
+    records = 0;
+    const auto it = show_members_.find(member);
+
+    if (it == show_members_.end()) {
+        return {};
+    }
+
+    ShowMember& sm = it->second;
+
+    // Too late to show: never made there, so never told gone.
+    while (!sm.out.empty() && now - sm.out.front().ms > kShowLateMs) {
+        sm.live.erase(sm.out.front().record.id);
+        sm.out.pop_front();
+    }
+
+    std::vector<std::uint16_t> gone;
+
+    for (const auto& [id, left] : sm.gone) {
+        gone.push_back(id);
+    }
+
+    sm.orders_out = show_orders_due(sm);
+    sm.orders_out_all = sm.orders_due;
+    std::size_t bytes = 5 + 2 * gone.size() + (sm.orders_out.empty() ? 0 : 1 + 3 * sm.orders_out.size());
+
+    if (bytes > room) {
+        sm.orders_out.clear();
+        return {};
+    }
+
+    std::vector<ShowRecord> chosen;
+
+    for (const ShowOut& o : sm.out) {
+        const std::size_t n = show_bytes(o.record);
+
+        if (bytes + n > room) {
+            break;
+        }
+
+        chosen.push_back(o.record);
+        chosen.back().age_ms = static_cast<std::uint16_t>(std::min<std::uint64_t>(now - o.ms, 0xFFFF));
+        bytes += n;
+    }
+
+    records = chosen.size();
+    return encode_show_tail(chosen, gone, sm.orders_out);
+}
+
+void World::show_sent(std::int32_t member, std::size_t records) {
+    const auto it = show_members_.find(member);
+
+    if (it == show_members_.end()) {
+        return;
+    }
+
+    ShowMember& sm = it->second;
+
+    for (std::size_t i = 0; i < records && !sm.out.empty(); ++i) {
+        sm.out.pop_front();
+        ++show_sent_count_;
+    }
+
+    for (auto g = sm.gone.begin(); g != sm.gone.end();) {
+        g = --g->second <= 0 ? sm.gone.erase(g) : std::next(g);
+    }
+
+    // Orders: what it was told now stands, and all of them were told when they were due.
+    for (const ShowOrder& order : sm.orders_out) {
+        sm.orders_told[order.id] = order.command;
+    }
+
+    if (sm.orders_out_all) {
+        sm.orders_due = false;
+        sm.orders_ms = clock_();
+    }
+
+    sm.orders_out.clear();
+    sm.orders_out_all = false;
+}
