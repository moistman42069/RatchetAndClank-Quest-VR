+void Coop::on_extra(std::int32_t sender, const Bytes& bytes) {
+    if (bytes.size() < 5 || bytes.size() > 5 + kPlayerExtraMost) {
+        return;
+    }
+
+    Reader r(bytes.data() + 1, bytes.size() - 1);
+    const std::int32_t owner = r.i32();
+
+    if (!r.ok() || owner == session_.id() || !member_of(session_, owner)) {
+        return;
+    }
+
+    if (session_.role().host()) {
+        // A member speaks for itself only; the host passes it on with the next poses that go.
+        if (sender != owner) {
+            return;
+        }
+
+        relay_extra_[owner] = bytes;
+    } else if (sender != session_.host()) {
+        return;
+    }
+
+    const auto it = remotes_.find(owner);
+
+    if (it == remotes_.end() || it->second.figure < 0 || it->second.hidden) {
+        return;
+    }
+
+    const int slot = game_.figure_slot(it->second.figure);
+
+    if (slot >= 0) {
+        it->second.extra_ms = clock_();
+        game_.player_extra_deliver(slot, Bytes(bytes.begin() + 5, bytes.end()));
+    }
+}
+
+void Coop::tell_silent(std::uint64_t now) {
+    if (now - silent_ms_ < 250) {
+        return;
+    }
+
+    silent_ms_ = now;
+
+    for (auto& [id, r] : remotes_) {
+        if (r.figure < 0 || r.hidden || now - r.extra_ms < 500) {
+            continue;
+        }
+
+        const int slot = game_.figure_slot(r.figure);
+
+        if (slot >= 0) {
+            r.extra_ms = now - 250;  // told again in a quarter of a second, as long as it says nothing
+            game_.player_extra_deliver(slot, Bytes{});
+        }
     }
 }
 
