+/* Ratchet Quest VR's: the Quest fork's player_extra_* (openrac_mod.h), when the port has them. */
+bool ModGame::player_extra(mp::Bytes& out) {
+    const openrac_api& api = mod_.api();
+    if (api.size < offsetof(openrac_api, player_extra_read) + sizeof(void*) || api.player_extra_read == nullptr) {
+        return false;
+    }
+    std::uint8_t data[OPENRAC_PLAYER_EXTRA_MAX];
+    std::uint32_t stamp = 0;
+    const int size = api.player_extra_read(data, sizeof data, &stamp);
+    if (size <= 0 || size > static_cast<int>(sizeof data) || stamp == extra_stamp_) {
+        return false;
+    }
+    extra_stamp_ = stamp;
+    out.assign(data, data + size);
+    return true;
+}
+
+void ModGame::player_extra_deliver(int slot, const mp::Bytes& bytes) {
+    const openrac_api& api = mod_.api();
+    if (api.size < offsetof(openrac_api, player_extra_deliver) + sizeof(void*) || api.player_extra_deliver == nullptr
+        || bytes.size() > OPENRAC_PLAYER_EXTRA_MAX) {
+        return;
+    }
+    api.player_extra_deliver(slot, bytes.empty() ? nullptr : bytes.data(), static_cast<std::uint32_t>(bytes.size()));
+}
+
 bool ModGame::start(int level, const mp::Bytes& save) {
     return mod_.play_start(level, save) == OPENRAC_HOOK_OK;
 }
