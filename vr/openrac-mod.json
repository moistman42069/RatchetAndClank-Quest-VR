  "settings": [
    { "key": "view", "name": "View", "type": "choice", "default": "first",
      "choices": [ { "value": "first", "name": "First person" }, { "value": "third", "name": "Third person" }, { "value": "screen", "name": "Big screen" } ] },
    { "key": "third_person_controls", "name": "Third person controls", "type": "choice", "default": "gamepad",
      "choices": [ { "value": "gamepad", "name": "Gamepad" }, { "value": "vr", "name": "VR" } ] },
    { "key": "dpad", "name": "D-pad", "type": "choice", "default": "head",
