{
  "format": 2,
  "id": "quest-vr",
  "name": "Quest VR",
  "version": "0.1.8",
  "author": "Ratchet & Clank Quest VR contributors",
  "description": "Ratchet & Clank in a standalone headset through OpenXR: first person with head tracking, hand aiming and Touch controllers.",
  "license": "GPL-3.0-or-later",
  "api": "1.10",
  "games": { "rac1": ["pal", "ntsc"] },
  "hooks": [
    "rac1.vendor.menu_update",
    "rac1.vendor.open",
    "rac1.vendor.close",
    "rac1.menu.backdrop",
    "rac1.ui.frame",
    "rac1.hud.quick_select_draw",
    "rac1.hud.frame",
    "rac1.moby.wrench.update",
    "rac1.player.update_motion_input",
    "rac1.player.turn_to_heading",
    "rac1.player.set_planar_velocity",
    "rac1.moby.moby168.update",
    "rac1.moby.moby157.update",
    "rac1.moby.moby177.update",
    "rac1.moby.swingshot.update",
    "rac1.moby.pyrocitor.update",
    "rac1.moby.ryno.update",
    "rac1.moby.suck_cannon.update",
    "rac1.moby.moby175.update",
    "rac1.moby.morphoray.update",
    "rac1.moby.moby163.update",
    "rac1.moby.moby192.update",
    "rac1.moby.mine_glove.update",
    "rac1.moby.decoy_glove.update",
    "rac1.moby.hero_bomb.update",
    "rac1.moby.mine.update",
    "rac1.moby.thrown_object.update",
    "rac1.moby.bomb_230.update",
    "rac1.moby.carrier.update",
    "rac1.moby.hydrodisplacer_pad.update",
    "rac1.moby.moby188.update",
    "rac1.moby.target_tracker.update",
    "rac1.weapon.blaster.auto_aim",
    "rac1.moby.mountable_turret.update",
    "rac1.moby.moby1267.update",
    "rac1.moby.cannon.update",
    "rac1.hud.quick_select_update",
    "rac1.player.local_point",
    "rac1.text.print_center",
    "rac1.hud.orders_ring_update",
    "rac1.sound.update",
    "rac1.player.check_ledge_grab",
    "rac1.player.check_ledge_grab_b",
    "rac1.weapon.take_ammo",
    "rac1.moby.jet_fighter.update",
    "rac1.moby.fighter_jet_69.update",
    "rac1.moby.fighter_jet_1379.update",
    "rac1.moby.visibomb_missile.update",
    "rac1.moby.bolt_crank.update",
    "rac1.moby.trespasser_puzzle.update"
  ],
  "settings": [
    { "key": "view", "name": "View", "type": "choice", "default": "first",
      "choices": [ { "value": "first", "name": "First person" }, { "value": "third", "name": "Third person" }, { "value": "screen", "name": "Big screen" } ] },
    { "key": "cutscenes", "name": "Cutscenes", "type": "choice", "default": "eyes",
      "choices": [ { "value": "eyes", "name": "Through Ratchet's eyes" }, { "value": "vr", "name": "In VR, around you" }, { "value": "screen", "name": "On a screen" } ] },
    { "key": "turn", "name": "Turning", "type": "choice", "default": "smooth",
      "choices": [ { "value": "snap", "name": "Snap" }, { "value": "smooth", "name": "Smooth" } ] },
    { "key": "snap_degrees", "name": "Snap angle", "type": "float", "default": 45, "min": 15, "max": 90, "step": 5 },
    { "key": "smooth_degrees", "name": "Smooth turn speed", "type": "float", "default": 140, "min": 30, "max": 360, "step": 10 },
    { "key": "world_scale", "name": "World scale", "type": "float", "default": 1, "min": 0.7, "max": 1.5, "step": 0.05 },
    { "key": "hud_scale", "name": "HUD size", "type": "float", "default": 1, "min": 0.6, "max": 1.4, "step": 0.05 },
    { "key": "haptics", "name": "Vibration", "type": "bool", "default": true },
    { "key": "hand_aim", "name": "Aim with the right hand", "type": "bool", "default": true },
    { "key": "hide_body", "name": "Hide Ratchet's body in first person", "type": "bool", "default": true },
    { "key": "hand_weapon", "name": "Weapon in your right hand", "type": "bool", "default": true },
    { "key": "throw_by_hand", "name": "Throw bombs, mines and Decoys by hand", "type": "bool", "default": true },
    { "key": "swing_wrench", "name": "Swing the wrench for real", "type": "bool", "default": true },
    { "key": "two_handed", "name": "Two-handed weapons", "type": "bool", "default": true },
    { "key": "glyphs", "name": "Controller buttons in hints", "type": "bool", "default": true },
    { "key": "show_hands", "name": "Ratchet's hands", "type": "bool", "default": true },
    { "key": "grab_ledges", "name": "Grab ledges with your hands", "type": "bool", "default": true },
    { "key": "puzzle_over_tool", "name": "The Trespasser's rings over the tool", "type": "bool", "default": true },
    { "key": "shop_on_foot", "name": "The vendor's screens on the machine, walking while you shop", "type": "bool", "default": true },
    { "key": "menu_in_world", "name": "Menus in the world, the level around them", "type": "bool", "default": true },
    { "key": "room_scale", "name": "Walk around your room", "type": "bool", "default": true },
    { "key": "swim_strokes", "name": "Swim with your arms", "type": "bool", "default": true },
    { "key": "solid_hands", "name": "Solid walls for what you hold", "type": "bool", "default": true },
    { "key": "refresh_hz", "name": "Refresh rate", "type": "int", "default": 72, "min": 60, "max": 120 },
    { "key": "resolution", "name": "Resolution", "type": "float", "default": 1, "min": 0.5, "max": 1.5, "step": 0.05 }
  ]
}
